{
  "Brain": {
    "Provider": "ClaudeCode",
    "FallbackProvider": "",
    "ClaudeCode": {
      "ExecutablePath": "claude",
      "Model": "haiku",
      "WorkingDirectory": "%LOCALAPPDATA%/EnglishTutor/brain",
      "TimeoutSeconds": 60,
      "UseResume": true,
      "OutputMode": "JsonSchema"
    },
    "Ollama": {
      "Endpoint": "http://localhost:11434",
      "Model": "qwen2.5:14b-instruct-q4_K_M",
      "Temperature": 0.6,
      "TimeoutSeconds": 60,
      "OutputMode": "JsonSchema"
    }
  },
  "Voice": {
    "Enabled": false
  },
  "Tts": {
    "Speed": 1.0,
    "Piper": {
      "ExecutablePath": "models/piper/piper.exe",
      "ModelPath": "models/piper/en_US-lessac-medium.onnx",
      "TimeoutSeconds": 30
    }
  },
  "Stt": {
    "LowConfidenceThreshold": 0.6
  },
  "Conversation": {
    "MaxTurnsInWindow": 10
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "logs/englishtutor-.log",
          "rollingInterval": "Day",
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ]
  }
}

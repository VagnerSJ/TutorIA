{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/post-edit-dotnet.mjs"],
            "timeout": 300,
            "statusMessage": "dotnet format + build + affected tests"
          }
        ]
      }
    ]
  }
}
